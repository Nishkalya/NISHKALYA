{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A portfolio project entity",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The title of the project" },
        "category": { "type": "string", "description": "The category of the project" },
        "desc": { "type": "string", "description": "Short description of the project" },
        "iconType": { "type": "string", "enum": ["message", "eye", "layout", "chart"], "description": "Icon type identifier" },
        "link": { "type": "string", "format": "uri", "description": "Live preview URL" },
        "screenshots": { "type": "array", "items": { "type": "string" }, "description": "URLs of project screenshots" },
        "videoUrl": { "type": "string", "format": "uri", "description": "URL of a project video" },
        "fullDetails": {
          "type": "object",
          "properties": {
            "overview": { "type": "string", "description": "Detailed markdown overview" },
            "features": { "type": "array", "items": { "type": "string" }, "description": "List of key features" },
            "techStack": { 
              "type": "array", 
              "items": { 
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "role": { "type": "string" }
                }
              }
            },
            "structure": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "desc": { "type": "string" }
                }
              }
            },
            "license": { "type": "string" },
            "status": { "type": "string", "description": "e.g., Active Node, Production" }
          }
        },
        "isActive": { "type": "boolean", "description": "Whether the project is visible on the main page" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "desc", "iconType"]
    },
    "Admin": {
      "title": "Admin",
      "description": "User with administrative privileges",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin"] }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "projects": {
      "schema": "Project",
      "description": "Collection of projects shown on the portfolio"
    },
    "admins": {
      "schema": "Admin",
      "description": "Collection of admin users"
    }
  }
}
